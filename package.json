{
  "name": "dark-mechanicus",
  "version": "0.32.0",
  "private": true,
  "description": "Dark factory desktop app for coding projects",
  "author": "davgor",
  "repository": {
    "type": "git",
    "url": "https://github.com/davgor/DarkMechanicus.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "npm run package:win",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p fireguard/tsconfig.json",
    "lint": "oxlint src scripts resources/skitarii/extension",
    "test": "vitest run && vitest run --config fireguard/vitest.config.ts",
    "test:fireguard": "vitest run --config fireguard/vitest.config.ts",
    "coverage": "vitest run --coverage",
    "fireguard": "node fireguard/bin/fireguard.mjs",
    "deadcode": "node scripts/deadcode-check.mjs",
    "deadcode:refresh": "node scripts/deadcode-refresh.mjs",
    "mcp": "node out/main/mcp.js",
    "dm": "node out/main/cli.js",
    "smoke:mcp": "node scripts/mcp-smoke.mjs",
    "spike:claims": "tsx scripts/spike/claim-stress.ts",
    "postinstall": "node scripts/ptyHelperMode.mjs && node scripts/xtermGraphemesPatch.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "node-pty": "1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/minimatch": "^5.1.2",
    "@types/node": "~24.19.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "electron": "^42.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.1",
    "minimatch": "^11.0.3",
    "oxlint": "^1.71.0",
    "ts-prune": "^0.10.3",
    "tsx": "^4.23.11",
    "typescript": "^5.5.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "^5.1.0",
      "@electron/universal": "^3.0.6"
    },
    "@electron/asar": "^4.3.1",
    "filelist": "^2.0.2",
    "glob": "^14.0.3",
    "minimatch": "$minimatch",
    "ts-prune": {
      "ts-morph": "^28.0.0"
    }
  },
  "build": {
    "appId": "com.davgor.darkmechanicus",
    "productName": "DarkMechanicus",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "resources/skitarii",
        "to": "skitarii"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "afterPack": "./scripts/ptyHelperMode.mjs",
    "publish": {
      "provider": "github",
      "owner": "davgor",
      "repo": "DarkMechanicus"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false
    }
  },
  "optionalDependencies": {
    "@electron/windows-sign": "^1.2.2"
  }
}
